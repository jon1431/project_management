{
  "collections": {
    "users": {
      "description": "Store minimal user information with privacy-first approach",
      "document_id": "auto-generated by Firebase Auth",
      "fields": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "required": true,
          "indexed": true
        },
        "email": {
          "type": "string | null",
          "description": "User email (null for anonymous users)",
          "required": false,
          "pii": true
        },
        "displayName": {
          "type": "string | null",
          "description": "Optional display name (null for anonymous)",
          "required": false,
          "pii": true
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Flag indicating if user is anonymous",
          "required": true,
          "default": true
        },
        "role": {
          "type": "string",
          "description": "User role: 'user' | 'moderator' | 'admin'",
          "required": true,
          "default": "user",
          "indexed": true
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Account creation timestamp",
          "required": true,
          "serverTimestamp": true
        },
        "lastActive": {
          "type": "timestamp",
          "description": "Last activity timestamp",
          "required": false,
          "serverTimestamp": true
        },
        "reportsCount": {
          "type": "number",
          "description": "Total reports submitted by user",
          "required": true,
          "default": 0
        }
      },
      "privacy_notes": [
        "Store ONLY necessary information",
        "No location data stored in user profile",
        "Anonymous users have minimal data (uid, isAnonymous, createdAt only)",
        "Email only stored if user opts for non-anonymous account"
      ]
    },

    "reports": {
      "description": "Social injustice reports with privacy and moderation features",
      "document_id": "auto-generated",
      "fields": {
        "id": {
          "type": "string",
          "description": "Auto-generated document ID",
          "required": true,
          "indexed": true
        },
        "title": {
          "type": "string",
          "description": "Brief title of the incident",
          "required": true,
          "maxLength": 200,
          "indexed": true
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the incident",
          "required": true,
          "maxLength": 5000
        },
        "category": {
          "type": "string",
          "description": "Incident category: 'corruption' | 'abuse' | 'discrimination' | 'violence' | 'other'",
          "required": true,
          "indexed": true
        },
        "location": {
          "type": "string",
          "description": "General location description (no precise coordinates)",
          "required": false,
          "privacy": "Store general area only, not precise coordinates"
        },
        "locationCoords": {
          "type": "geopoint | null",
          "description": "Optional general area coordinates (rounded to protect privacy)",
          "required": false,
          "privacy": "Round to nearest 0.1 degree for privacy"
        },
        "authorId": {
          "type": "string",
          "description": "Reference to user document (uid)",
          "required": true,
          "indexed": true
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether report is submitted anonymously",
          "required": true,
          "default": true,
          "indexed": true
        },
        "status": {
          "type": "string",
          "description": "Report status: 'pending' | 'under_review' | 'verified' | 'rejected' | 'resolved'",
          "required": true,
          "default": "pending",
          "indexed": true,
          "moderation": "Only moderators can change this field"
        },
        "visibility": {
          "type": "string",
          "description": "Visibility level: 'private' | 'public'",
          "required": true,
          "default": "private",
          "indexed": true,
          "privacy": "Only 'verified' reports can be 'public'"
        },
        "upvotes": {
          "type": "number",
          "description": "Number of community upvotes (for verified reports)",
          "required": true,
          "default": 0
        },
        "viewCount": {
          "type": "number",
          "description": "Number of times report was viewed",
          "required": true,
          "default": 0
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Report submission timestamp",
          "required": true,
          "serverTimestamp": true,
          "indexed": true
        },
        "updatedAt": {
          "type": "timestamp",
          "description": "Last update timestamp",
          "required": true,
          "serverTimestamp": true
        },
        "verifiedAt": {
          "type": "timestamp | null",
          "description": "Timestamp when report was verified",
          "required": false
        },
        "moderatorId": {
          "type": "string | null",
          "description": "UID of moderator who last reviewed",
          "required": false
        },
        "moderatorNotes": {
          "type": "string",
          "description": "Internal notes from moderators (not public)",
          "required": false,
          "private": true
        },
        "mediaUrls": {
          "type": "array<string>",
          "description": "URLs to uploaded media (images, documents)",
          "required": false,
          "maxItems": 5
        },
        "tags": {
          "type": "array<string>",
          "description": "Search tags for categorization",
          "required": false,
          "indexed": true
        }
      },
      "indexes": [
        {
          "fields": ["status", "createdAt DESC"],
          "description": "Query reports by status and date"
        },
        {
          "fields": ["visibility", "status", "createdAt DESC"],
          "description": "Query public verified reports"
        },
        {
          "fields": ["authorId", "createdAt DESC"],
          "description": "Query user's own reports"
        },
        {
          "fields": ["category", "status", "createdAt DESC"],
          "description": "Query reports by category"
        }
      ],
      "privacy_notes": [
        "Only author and moderators can see 'pending' reports",
        "Only 'verified' reports are publicly visible",
        "Anonymous reports hide authorId from public view",
        "Location data is generalized for privacy"
      ]
    },

    "resources": {
      "description": "Educational resources about rights, justice, and reporting",
      "document_id": "auto-generated",
      "fields": {
        "id": {
          "type": "string",
          "description": "Auto-generated document ID",
          "required": true
        },
        "title": {
          "type": "string",
          "description": "Resource title",
          "required": true,
          "indexed": true
        },
        "description": {
          "type": "string",
          "description": "Brief description of the resource",
          "required": true
        },
        "category": {
          "type": "string",
          "description": "Resource category: 'legal_rights' | 'safety' | 'reporting_guide' | 'support' | 'general'",
          "required": true,
          "indexed": true
        },
        "type": {
          "type": "string",
          "description": "Resource type: 'article' | 'video' | 'guide' | 'external_link' | 'hotline'",
          "required": true
        },
        "content": {
          "type": "string",
          "description": "Main content (markdown supported)",
          "required": false,
          "maxLength": 10000
        },
        "url": {
          "type": "string",
          "description": "External URL if applicable",
          "required": false
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Thumbnail image URL",
          "required": false
        },
        "language": {
          "type": "string",
          "description": "Content language code (ISO 639-1)",
          "required": true,
          "default": "en"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether resource is published",
          "required": true,
          "default": false,
          "indexed": true
        },
        "priority": {
          "type": "number",
          "description": "Display priority (higher = more important)",
          "required": true,
          "default": 0
        },
        "viewCount": {
          "type": "number",
          "description": "Number of views",
          "required": true,
          "default": 0
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Resource creation timestamp",
          "required": true,
          "serverTimestamp": true
        },
        "updatedAt": {
          "type": "timestamp",
          "description": "Last update timestamp",
          "required": true,
          "serverTimestamp": true
        },
        "tags": {
          "type": "array<string>",
          "description": "Search tags",
          "required": false,
          "indexed": true
        }
      },
      "indexes": [
        {
          "fields": ["isPublished", "priority DESC", "createdAt DESC"],
          "description": "Query published resources by priority"
        },
        {
          "fields": ["category", "isPublished", "createdAt DESC"],
          "description": "Query resources by category"
        }
      ]
    },

    "reportVotes": {
      "description": "Track user votes on verified reports to prevent duplicate voting",
      "document_id": "{userId}_{reportId}",
      "fields": {
        "userId": {
          "type": "string",
          "description": "User who voted",
          "required": true,
          "indexed": true
        },
        "reportId": {
          "type": "string",
          "description": "Report that was voted on",
          "required": true,
          "indexed": true
        },
        "voteType": {
          "type": "string",
          "description": "Type of vote: 'upvote' | 'support'",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Vote timestamp",
          "required": true,
          "serverTimestamp": true
        }
      }
    },

    "auditLog": {
      "description": "Audit trail for moderation actions (SDG 16 accountability)",
      "document_id": "auto-generated",
      "fields": {
        "id": {
          "type": "string",
          "description": "Auto-generated document ID",
          "required": true
        },
        "action": {
          "type": "string",
          "description": "Action type: 'status_change' | 'report_delete' | 'user_ban' | 'resource_publish'",
          "required": true,
          "indexed": true
        },
        "resourceType": {
          "type": "string",
          "description": "Type of resource affected: 'report' | 'user' | 'resource'",
          "required": true,
          "indexed": true
        },
        "resourceId": {
          "type": "string",
          "description": "ID of affected resource",
          "required": true,
          "indexed": true
        },
        "moderatorId": {
          "type": "string",
          "description": "UID of moderator who performed action",
          "required": true,
          "indexed": true
        },
        "details": {
          "type": "object",
          "description": "Additional details about the action",
          "required": false
        },
        "timestamp": {
          "type": "timestamp",
          "description": "Action timestamp",
          "required": true,
          "serverTimestamp": true,
          "indexed": true
        }
      },
      "indexes": [
        {
          "fields": ["resourceType", "resourceId", "timestamp DESC"],
          "description": "Query audit trail for specific resource"
        },
        {
          "fields": ["moderatorId", "timestamp DESC"],
          "description": "Query actions by moderator"
        }
      ]
    }
  },

  "data_minimization_principles": [
    "Collect only essential data for app functionality",
    "Anonymous users have minimal stored data",
    "No tracking of user behavior beyond app functionality",
    "Location data is generalized, never precise",
    "PII is encrypted and access-controlled"
  ],

  "sdg16_compliance": [
    "Transparency through audit logs",
    "Accountability through moderation trail",
    "Privacy protection for vulnerable reporters",
    "Access to justice through anonymous reporting",
    "Strong institutions through verified data"
  ]
}
